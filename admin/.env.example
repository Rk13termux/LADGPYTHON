# ---------------------------------------------------------------------------
# CHMODX · Panel de Administración Pro
# Copia este archivo como admin/.env y rellena los valores.
# admin/.env está excluido de Git: nunca subas estas claves.
# ---------------------------------------------------------------------------

# URL del proyecto (Supabase → Settings → API → Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública. La usa el sitio para insertar visitas y leads.
SUPABASE_ANON_KEY=

# Clave de servicio. Solo para el panel de escritorio: permite leer las tablas
# aunque RLS bloquee al rol anon. NUNCA la incluyas en el frontend público.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
# Ruta del proyecto web (por defecto, la carpeta padre de admin/)
# CHMODX_PROJECT_ROOT=/ruta/a/LANDINGPYTHON

# Dominio público usado en los enlaces de la plantilla maestra
CHMODX_SITE_URL=https://chmodxcode.pro

# Remoto y rama de Git
CHMODX_GIT_REMOTE=origin
CHMODX_GIT_BRANCH=main

# Comando de build ejecutado antes de cada publicación
CHMODX_BUILD_COMMAND=python3 scripts/build.py

# ---------------------------------------------------------------------------
# OmniRoute · generación de borradores con IA (opcional)
# ---------------------------------------------------------------------------
# Servidor local: omniroute serve --daemon
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
